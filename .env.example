# Your self-hosted Vikunja instance
VIKUNJA_BASE_URL=https://vikunja.example.com
VIKUNJA_API_TOKEN=xxxxxxxxxxxxxxxx
VIKUNJA_PROJECT_ID=1

# SMTP credentials used to send the ALL CAPS notification email.
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
NOTIFY_EMAIL_TO=scott@scottwamba.ch

# Optional: names of the Kanban buckets to read from (defaults shown below).
# TODO_BUCKET_NAME=To-Do
# DOING_BUCKET_NAME=Doing

# The public URL this app is deployed at. Used to generate correct social share
# preview image URLs (Open Graph / Twitter cards).
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.com
